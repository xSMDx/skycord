# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────
dist/
dist-ssr/
*.local

# ── Env & secrets (NEVER commit) ──────────────────────────────
.env
.env.*
!.env.example

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Editor / OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# ── Misc / certs ──────────────────────────────────────────────
*.pem
*.key
coverage/
.cache/

# runtime state for the server-typecheck Stop hook
.claude/.typecheck-state

# graphify's output cache — 44 files of generated AST/semantic JSON that were
# committed by accident. Regenerated on demand; nothing reads them from git.
graphify-out/

# A Windows path committed as a single filename (the colon survived as U+F03A),
# so it could never check out cleanly on the Linux server. Removed from the
# index; this stops the tool that produced it re-adding one.
H*projects*sykord*task-*-report.md

# Instance voice servers — holds LiveKit API secrets, same as .env.
voice-servers.json

# Performance-mode memory probe: real credentials and per-run samples.
desktop/scripts/.probe.env
desktop/.probe/

# Native addon build output — compiled from source, never committed.
desktop/native/build/

# The music service installs its own deps: it is a separate process in a
# separate container and must not pull a native WebRTC binary into the app's.
music/node_modules/
music/dist-proof/
music/dist/
