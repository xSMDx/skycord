# ── Server ─────────────────────────────────────────────────────────────
PORT=3001

# LEAVE THIS AS production unless you are developing on localhost.
# It is not a logging switch: auth cookies get `Secure` and `SameSite=Strict`
# only when it reads exactly "production". Anything else serves login cookies
# that a network can read and that travel on cross-site requests.
# The server refuses to start in development mode on a non-localhost origin
# rather than let that pass quietly — see server/config/env.ts.
NODE_ENV=production

# ── MongoDB ─────────────────────────────────────────────────────────────
# Your MongoDB 4.4 connection string
MONGO_URI=mongodb://localhost:27017/sykord

# ── JWT Secrets ─────────────────────────────────────────────────────────
# Generate BOTH with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use DIFFERENT values for each — never share these
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_1
JWT_REFRESH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_2

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS / Cookie ───────────────────────────────────────────────────────
# In production set this to your actual domain e.g. sykord.app
CLIENT_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost

# ── LiveKit (voice/video) ───────────────────────────────────────────────
# LIVEKIT_URL is the client-reachable signalling URL returned to the browser.
# Dev (Windows → VPS): ws://<vps-ip>:7880   ·   Prod: wss://livekit.yourdomain
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecret12

# ── GIFs (KLIPY) ────────────────────────────────────────────────────────
# Server-side only: KLIPY puts the key in the URL path, so it must never
# reach the browser. Request one at https://klipy.com/developers
KLIPY_API_KEY=REPLACE_WITH_YOUR_KLIPY_KEY

# ── Email / password reset (Resend) ─────────────────────────────────────
# Optional. Without these, password reset is unavailable and the login page
# hides "Forgot?" rather than offering a link that can never arrive.
#
# 1. Create a key at https://resend.com
# 2. VERIFY A DOMAIN there and use an address on it below. This is the step
#    people miss: with an unverified domain every send is rejected, and the
#    app cannot tell you because the failure happens at the provider.
RESEND_API_KEY=
EMAIL_FROM=Skycord <noreply@yourdomain.com>

# Where reset links point. Defaults to CLIENT_ORIGIN, which is correct unless
# you serve the app somewhere other than the API's CORS origin.
APP_URL=

# ── Encryption key (optional but recommended) ───────────────────────────
# Encrypts third-party secrets stored in the database — today that means the
# LiveKit API secrets a server owner registers for their own voice channels.
#
# If unset, the key is derived from JWT_ACCESS_SECRET so a fresh instance works
# with no extra setup. The catch is worth knowing BEFORE you need it:
# rotating JWT_ACCESS_SECRET without this set makes every stored secret
# undecryptable, and owners must re-enter them. Set it once and rotation is safe.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
