{
  "name": "sykord",
  "version": "1.0.0",
  "description": "Skycord - Spatial Chat App",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "nodemon --exec \"ts-node --project tsconfig.server.json --transpile-only\" server/index.ts --watch server",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@phosphor-icons/vue": "^2.2.0",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-client": "^2.20.0",
    "livekit-server-sdk": "^2.15.5",
    "lottie-web": "^5.13.0",
    "lucide-vue-next": "^1.0.0",
    "mongoose": "^8.3.1",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "validator": "^13.11.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.7",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.11.9",
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.12"
  }
}
